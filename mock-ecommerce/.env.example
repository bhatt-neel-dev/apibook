# Copy to .env and fill in a project-level API key from the APILens dashboard.
APILENS_API_KEY=apilens_your_project_key_here
APILENS_PROJECT_SLUG=neels-store
# Local ingest runs on :8001 (prod default is https://ingest.apilens.ai/v1).
APILENS_BASE_URL=http://localhost:8001/v1
APILENS_ENVIRONMENT=development
