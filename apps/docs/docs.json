{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "apiLens",
  "styling": {
    "css": "styles.css"
  },
  "colors": {
    "primary": "#111111",
    "light": "#6B7280",
    "dark": "#000000"
  },
  "favicon": "/logo/favicon/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/how-it-works",
              "getting-started/data-privacy"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/traffic",
              "dashboard/endpoints",
              "dashboard/request-logs",
              "dashboard/tracing",
              "dashboard/consumers",
              "dashboard/errors"
            ]
          },
          {
            "group": "Setup Guides",
            "pages": [
              "setup-guides/fastapi",
              "setup-guides/django",
              "setup-guides/flask",
              "setup-guides/starlette",
              "setup-guides/litestar",
              "setup-guides/blacksheep",
              "setup-guides/express",
              "setup-guides/other-frameworks"
            ]
          },
          {
            "group": "SDK Reference",
            "pages": [
              "sdk-reference/python-configuration",
              "sdk-reference/consumers",
              "sdk-reference/path-templating",
              "sdk-reference/tracing"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/projects-apps-keys",
              "auth/authentication-flow",
              "auth/passwordless-and-password"
            ]
          },
          {
            "group": "Ingest API",
            "pages": [
              "ingest/ingest-api",
              "ingest/request-schema"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "roadmap",
              "support/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Ingest API",
            "openapi": {
              "source": "https://ingest.apilens.ai/v1/openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      },
      {
        "tab": "Blog & Releases",
        "groups": [
          {
            "group": "Engineering Blog",
            "pages": [
              "blog/server-driven-filtering",
              "blog/multi-tenant-guardrails",
              "blog/clickhouse-ingest-patterns"
            ]
          },
          {
            "group": "Release Notes",
            "pages": [
              "releases/alpha-1-launch"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo-transparent.svg",
    "dark": "/logo/logo-transparent.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://apilens.ai"
      },
      {
        "label": "Discord",
        "href": "https://discord.com/invite/GucYGFRh"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/apilens/apilens"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.apilens.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/apilens/apilens",
      "discord": "https://discord.com/invite/GucYGFRh"
    }
  },
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/"
    },
    {
      "source": "/customer/troubleshooting",
      "destination": "/support/troubleshooting"
    },
    {
      "source": "/sdk/python-setup",
      "destination": "/sdk-reference/python-configuration"
    },
    {
      "source": "/customer/create-your-first-app",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/customer/monitor-endpoints-and-logs",
      "destination": "/dashboard/request-logs"
    },
    {
      "source": "/customer/introduction",
      "destination": "/"
    },
    {
      "source": "/customer/sign-in-and-access",
      "destination": "/auth/passwordless-and-password"
    },
    {
      "source": "/sdk/building-an-sdk",
      "destination": "/ingest/ingest-api"
    },
    {
      "source": "/getting-started/architecture",
      "destination": "/getting-started/how-it-works"
    }
  ]
}
